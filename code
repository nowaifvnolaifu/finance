         << ";  1-mo 95% VaR $" << max(0.0, 1.645 * r.volP / sqrt(12.0) - r.ret / 12) * value << "\n";
}

void rankCandidates(const Data& d, const vector<string>& base, const Result& baseRes, double maxW) {
    vector<int> bc;
    for (auto& b : base) bc.push_back(d.col(b));
    struct Row { string t; double corr, w, gain; };
    vector<Row> rows;
    // base Sharpe on the base-only data window
    for (size_t j = 0; j < d.names.size(); j++) {
        const string& c = d.names[j];
        if (find(TICKERS.begin(), TICKERS.end(), c) != TICKERS.end()) continue;
        Mat px; vector<string> nm = base; nm.push_back(c);
        for (size_t t = 0; t < d.px.size(); t++) {
            bool ok = !isnan(d.px[t][j]);
            for (int b : bc) ok = ok && !isnan(d.px[t][b]);
            if (!ok) continue;
            Vec row; for (int b : bc) row.push_back(d.px[t][b]);
            row.push_back(d.px[t][j]);
            px.push_back(row);
        }
        if (px.size() < 250) continue;
        Mat R = logReturns(px);
        Mat S = shrunkCov(R); Vec mu, beta; expectedReturns(R, nm, mu, beta);
        Vec w = optimizeLongOnly(mu, S, RISK_FREE, maxW, true);
        double sh = portSharpe(w, mu, S, RISK_FREE);
        // base-only Sharpe on this window with the base optimum weights
        Mat Rb; for (auto& r : R) Rb.push_back(Vec(r.begin(), r.end() - 1));
        Mat Sb = shrunkCov(Rb); Vec mub, bb; expectedReturns(Rb, base, mub, bb);
        double shBase = portSharpe(baseRes.w, mub, Sb, RISK_FREE);
        // correlation of candidate with current optimal portfolio
        int T = (int)R.size(); Vec p(T), q(T);
        for (int t = 0; t < T; t++) { p[t] = dot(Vec(R[t].begin(), R[t].end() - 1), baseRes.w); q[t] = R[t].back(); }
        double pm = 0, qm = 0; for (int t = 0; t < T; t++) { pm += p[t] / T; qm += q[t] / T; }
        double cpq = 0, cpp = 0, cqq = 0;
        for (int t = 0; t < T; t++) { cpq += (p[t]-pm)*(q[t]-qm); cpp += (p[t]-pm)*(p[t]-pm); cqq += (q[t]-qm)*(q[t]-qm); }
        rows.push_back({c, cpq / sqrt(cpp * cqq), w.back(), sh - shBase});
    }
    if (rows.empty()) { cout << "\n(no candidate columns with enough history in the CSV)\n"; return; }
    sort(rows.begin(), rows.end(), [](const Row& a, const Row& b) { return a.gain > b.gain; });
    cout << fixed << setprecision(3)
         << "\n=== CANDIDATES TO ADD (ranked by Sharpe gain after re-optimizing) ===\n"
         << setw(9) << "ticker" << setw(14) << "corr_to_port" << setw(10) << "sugg_wt" << setw(13) << "sharpe_gain" << "\n";
    for (size_t i = 0; i < min<size_t>(8, rows.size()); i++)
        cout << setw(9) << rows[i].t << setw(14) << rows[i].corr << setw(10) << rows[i].w << setw(13) << rows[i].gain << "\n";
}

double usdPerShare(const string& t, double price, double fx) {
    if (t == "YU.L") return price / 100.0 * fx;                          // pence -> GBP -> USD
    if (t.size() > 2 && t.substr(t.size() - 2) == ".L") return price * fx;
    return price;
}
map<string, double> parseShares(const string& s) {
    map<string, double> m; stringstream ss(s); string kv;
    while (getline(ss, kv, ',')) {
        size_t e = kv.find('=');
        if (e != string::npos) m[kv.substr(0, e)] = atof(kv.c_str() + e + 1);
    }
    return m;
}

// -------------------------------- MAIN --------------------------------------
int main(int argc, char** argv) {
    string csv, sharesArg; double value = 10000, maxW = 0.35;
    int interval = 60, iterations = 0; bool demo = false, once = false;
    for (int i = 1; i < argc; i++) {
        string a = argv[i];
        auto next = [&]() { return i + 1 < argc ? string(argv[++i]) : string(); };
        if (a == "--csv") csv = next();
        else if (a == "--value") value = atof(next().c_str());
        else if (a == "--max-weight") maxW = atof(next().c_str());
        else if (a == "--interval") interval = atoi(next().c_str());
        else if (a == "--iterations") iterations = atoi(next().c_str());
        else if (a == "--shares") sharesArg = next();
        else if (a == "--demo") demo = true;
        else if (a == "--once") once = true;
    }
    Data d;
    if (demo) d = syntheticData();
    else if (csv.empty() || !loadCsv(csv, d)) {
        cerr << "Provide --csv prices.csv (see header comment) or use --demo\n";
        return 1;
    }
    vector<string> names;
    for (auto& t : TICKERS) {
        if (d.col(t) >= 0) names.push_back(t);
        else cerr << "WARNING: no column for " << t << " in the data (check ticker)\n";
    }
    if (names.size() < 2) { cerr << "Need at least 2 usable tickers.\n"; return 1; }
    vector<int> bc; for (auto& t : names) bc.push_back(d.col(t));

    // Base history: rows where every base ticker has a price.
    Mat hist; vector<string> hdates;
    for (size_t t = 0; t < d.px.size(); t++) {
        bool ok = true; Vec row;
        for (int j : bc) { ok = ok && !isnan(d.px[t][j]); row.push_back(d.px[t][j]); }
        if (ok) { hist.push_back(row); hdates.push_back(d.dates[t]); }
    }
    if (hist.size() < 250)
        cerr << "WARNING: only " << hist.size() << " overlapping days (<1 year); estimates unreliable.\n";

    auto shares = parseShares(sharesArg);
    Vec prevW; bool havePrev = false; int n = (int)names.size(), iter = 0;
    Vec last = hist.back();
    mt19937 gen(3); normal_distribution<double> N(0, 0.002);

    {   // initial static report (history only)
        Result r = analyze(hist, names, maxW);
        cout << "\nLoaded " << hist.size() << " daily rows (" << hdates.front() << " -> " << hdates.back() << ")";
        printStatic(r, names, value, maxW);
        Data cd = d;  // candidates ranking uses full CSV
        rankCandidates(cd, names, r, maxW);
        if (once) return 0;
    }
    cout << "\nLive updates every " << interval << "s. Ctrl+C to stop.\n";

    while (true) {
        Vec latest(n, NaN); double fx = 1.27;
        if (demo) { for (int j = 0; j < n; j++) latest[j] = last[j] *= exp(N(gen)); }
        else {
            for (int j = 0; j < n; j++) latest[j] = fetchPrice(names[j]);
            bool lon = false; for (auto& t : names) if (t == "YU.L") lon = true;
            if (lon) { double f = fetchPrice("GBPUSD=X"); if (!isnan(f)) fx = f; }
        }
        int missing = 0;
        for (int j = 0; j < n; j++) if (isnan(latest[j])) { latest[j] = hist.back()[j]; missing++; }
        if (missing == n) cerr << "[" << nowStr() << "] could not fetch any live price (is `curl` installed / online?); using last close\n";

        // Splice today's live row onto history (replace if today's row exists).
        Mat live = hist; string today = todayStr();
        double prevClose[64];
        bool todayRow = (hdates.back() == today);
        for (int j = 0; j < n; j++) prevClose[j] = hist[todayRow ? hist.size() - 2 : hist.size() - 1][j];
        if (todayRow) live.back() = latest; else live.push_back(latest);

        Result r = analyze(live, names, maxW);
        cout << "\n" << string(78, '=') << "\nUpdate " << nowStr() << "  (" << live.size() - 1 << " daily returns incl. live price)\n"
             << fixed << setprecision(3) << setw(7) << "" << setw(10) << "price" << setw(10) << "day_%"
             << setw(9) << "ann_vol" << setw(8) << "beta" << setw(9) << "exp_ret" << setw(9) << "weight"
             << (havePrev ? "  d_weight" : "") << "\n";
        for (int j = 0; j < n; j++) {
            cout << setw(7) << names[j] << setw(10) << latest[j] << setw(10) << (latest[j] / prevClose[j] - 1) * 100
                 << setw(9) << r.vol[j] << setw(8) << r.beta[j] << setw(9) << r.mu[j] << setw(9) << r.w[j];
            if (havePrev) cout << setw(10) << r.w[j] - prevW[j];
            cout << "\n";
        }
        cout << setprecision(1) << "\nPortfolio: exp return " << r.ret * 100 << "% | vol " << r.volP * 100 << "% | Sharpe "
             << setprecision(2) << r.sharpe << " | exp profit on $" << setprecision(0) << value << ": $" << r.ret * value
             << "/yr\nPC1 (market factor) " << r.pc1 * 100 << "% of variance | effective bets " << setprecision(1) << r.eff << "\n";

        if (!shares.empty()) {
            Vec usd(n); double tot = 0;
            for (int j = 0; j < n; j++) {
                auto it = shares.find(names[j]);
                usd[j] = (it == shares.end() ? 0.0 : it->second) * usdPerShare(names[j], latest[j], fx);
                tot += usd[j];
            }
            if (tot > 0) {
                cout << setprecision(0) << "\nYour holdings: $" << tot << "\n" << setw(7) << "" << setw(10) << "now_$"
                     << setw(8) << "now_%" << setw(10) << "target_%" << setw(15) << "trade_$(+buy)" << "\n";
                for (int j = 0; j < n; j++)
                    cout << setw(7) << names[j] << setw(10) << usd[j] << setw(8) << setprecision(1) << usd[j] / tot * 100
                         << setw(10) << r.w[j] * 100 << setw(15) << setprecision(0) << r.w[j] * tot - usd[j] << "\n";
            }
        }
        prevW = r.w; havePrev = true;
        if (iterations && ++iter >= iterations) break;
        this_thread::sleep_for(chrono::seconds(interval));
    }
    return 0;
}
