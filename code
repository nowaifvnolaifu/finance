using Vec = vector<double>;
using Mat = vector<Vec>;

// ------------------------------- CONFIG -------------------------------------
static const vector<string> TICKERS = {"QQQ", "ANT", "NVDA", "GH", "SPCX",
                                       "MRNA", "TRI", "VKTX", "YU.L"};
static const string BENCHMARK = "QQQ";
static const double TRADING_DAYS = 252, RISK_FREE = 0.04, MARKET_PREMIUM = 0.06;
static const double HIST_WEIGHT = 0.30, SHRINK = 0.20;
static const double NaN = numeric_limits<double>::quiet_NaN();

// ---------------------------- LINEAR ALGEBRA --------------------------------
Vec matvec(const Mat& A, const Vec& x) {
    Vec y(A.size(), 0.0);
    for (size_t i = 0; i < A.size(); i++)
        for (size_t j = 0; j < x.size(); j++) y[i] += A[i][j] * x[j];
    return y;
}
double dot(const Vec& a, const Vec& b) {
    double s = 0;
    for (size_t i = 0; i < a.size(); i++) s += a[i] * b[i];
    return s;
}
// Solve A x = b by Gaussian elimination with partial pivoting.
Vec solve(Mat A, Vec b) {
    int n = (int)b.size();
    for (int c = 0; c < n; c++) {
        int p = c;
        for (int r = c + 1; r < n; r++)
            if (fabs(A[r][c]) > fabs(A[p][c])) p = r;
        swap(A[c], A[p]); swap(b[c], b[p]);
        for (int r = c + 1; r < n; r++) {
            double f = A[r][c] / A[c][c];
            for (int k = c; k < n; k++) A[r][k] -= f * A[c][k];
            b[r] -= f * b[c];
        }
    }
    Vec x(n);
    for (int i = n - 1; i >= 0; i--) {
        double s = b[i];
        for (int k = i + 1; k < n; k++) s -= A[i][k] * x[k];
        x[i] = s / A[i][i];
    }
    return x;
}
// Cyclic Jacobi eigen-decomposition of a symmetric matrix.
// Returns eigenvalues (descending) and eigenvectors as columns of V.
void jacobiEigen(Mat A, Vec& vals, Mat& V) {
    int n = (int)A.size();
    V.assign(n, Vec(n, 0.0));
    for (int i = 0; i < n; i++) V[i][i] = 1.0;
    for (int sweep = 0; sweep < 100; sweep++) {
        double off = 0;
        for (int i = 0; i < n; i++)
            for (int j = i + 1; j < n; j++) off += A[i][j] * A[i][j];
        if (off < 1e-22) break;
        for (int p = 0; p < n; p++)
            for (int q = p + 1; q < n; q++) {
                if (fabs(A[p][q]) < 1e-300) continue;
                double th = (A[q][q] - A[p][p]) / (2 * A[p][q]);
                double t = (th >= 0 ? 1 : -1) / (fabs(th) + sqrt(th * th + 1));
                double c = 1 / sqrt(t * t + 1), s = t * c;
                for (int k = 0; k < n; k++) {
                    double akp = A[k][p], akq = A[k][q];
                    A[k][p] = c * akp - s * akq; A[k][q] = s * akp + c * akq;
                }
                for (int k = 0; k < n; k++) {
                    double apk = A[p][k], aqk = A[q][k];
                    A[p][k] = c * apk - s * aqk; A[q][k] = s * apk + c * aqk;
                }
                for (int k = 0; k < n; k++) {
                    double vkp = V[k][p], vkq = V[k][q];
                    V[k][p] = c * vkp - s * vkq; V[k][q] = s * vkp + c * vkq;
                }
            }
    }
    vector<int> idx(n);
    for (int i = 0; i < n; i++) idx[i] = i;
    sort(idx.begin(), idx.end(), [&](int a, int b) { return A[a][a] > A[b][b]; });
    Vec v2(n); Mat V2(n, Vec(n));
    for (int j = 0; j < n; j++) {
        v2[j] = A[idx[j]][idx[j]];
        for (int k = 0; k < n; k++) V2[k][j] = V[k][idx[j]];
    }
    vals = v2; V = V2;
}

// ------------------------------- DATA ---------------------------------------
struct Data {
    vector<string> names, dates;
    Mat px;  // px[t][j], NaN = missing
    int col(const string& n) const {
        for (size_t j = 0; j < names.size(); j++) if (names[j] == n) return (int)j;
        return -1;
    }
};

string todayStr() {
    time_t t = time(nullptr); char b[16];
    strftime(b, sizeof b, "%Y-%m-%d", localtime(&t));
    return b;
}
string nowStr() {
    time_t t = time(nullptr); char b[24];
    strftime(b, sizeof b, "%Y-%m-%d %H:%M:%S", localtime(&t));
    return b;
}
void forwardFill(Data& d) {
    for (size_t t = 1; t < d.px.size(); t++)
        for (size_t j = 0; j < d.names.size(); j++)
            if (isnan(d.px[t][j])) d.px[t][j] = d.px[t - 1][j];
}
bool loadCsv(const string& path, Data& d) {
    ifstream f(path);
    if (!f) return false;
    string line;
    getline(f, line);
    {
        stringstream ss(line); string c; getline(ss, c, ',');
        while (getline(ss, c, ',')) {
            while (!c.empty() && (c.back() == '\r' || c.back() == ' ')) c.pop_back();
            d.names.push_back(c);
        }
    }
    while (getline(f, line)) {
        if (line.empty()) continue;
        stringstream ss(line); string c;
        getline(ss, c, ',');
        d.dates.push_back(c.substr(0, 10));
        Vec row;
        while (getline(ss, c, ',')) {
            char* e; double v = strtod(c.c_str(), &e);
            row.push_back(e == c.c_str() ? NaN : v);
        }
        row.resize(d.names.size(), NaN);
        d.px.push_back(row);
    }
    forwardFill(d);
    return !d.px.empty();
}
Data syntheticData() {
    mt19937 g(7); normal_distribution<double> N(0, 1);
    Data d;
    d.names = TICKERS;
    for (string s : {"SPY", "SCHD", "PG", "JNJ", "TLT", "GLD"}) d.names.push_back(s);
    int n = 756, k = (int)d.names.size();
    Vec beta(k), idio(k), drift(k);
    uniform_real_distribution<double> U(0, 1);
    for (int j = 0; j < k; j++) {
        beta[j] = 0.2 + 1.6 * U(g); idio[j] = 0.008 + 0.027 * U(g);
        drift[j] = 0.0004 + 0.0004 * N(g);
    }
    Vec p(k, 100.0);
    time_t t = time(nullptr) - 86400;
    vector<string> rev;
    while ((int)rev.size() < n) {
        tm* lt = localtime(&t);
        if (lt->tm_wday != 0 && lt->tm_wday != 6) {
            char b[16]; strftime(b, sizeof b, "%Y-%m-%d", lt); rev.push_back(b);
        }
        t -= 86400;
    }
    reverse(rev.begin(), rev.end());
    d.dates = rev;
    for (int i = 0; i < n; i++) {
        double m = 0.0005 + 0.011 * N(g);
        for (int j = 0; j < k; j++)
            p[j] *= exp(beta[j] * m + idio[j] * N(g) + drift[j]);
        d.px.push_back(p);
    }
    return d;
}

// ---------------------------- LIVE PRICES -----------------------------------
// Uses the system `curl`. Returns NaN if the request or parse fails.
double fetchPrice(const string& sym) {
    string enc;
    for (char c : sym) enc += (c == '=') ? "%3D" : string(1, c);
    string cmd = "curl -s -m 10 -A \"Mozilla/5.0\" "
                 "\"https://query1.finance.yahoo.com/v8/finance/chart/" + enc +
                 "?interval=1m&range=1d\"";
    FILE* p = popen(cmd.c_str(), "r");
    if (!p) return NaN;
    string out; char buf[4096]; size_t n;
    while ((n = fread(buf, 1, sizeof buf, p)) > 0) out.append(buf, n);
    pclose(p);
    size_t pos = out.find("\"regularMarketPrice\":");
    if (pos == string::npos) return NaN;
    return strtod(out.c_str() + pos + 21, nullptr);
}

// -------------------------- ANALYTICS CORE ----------------------------------
Mat logReturns(const Mat& px) {
    Mat r;
    for (size_t t = 1; t < px.size(); t++) {
        Vec row(px[t].size());
        for (size_t j = 0; j < row.size(); j++) row[j] = log(px[t][j] / px[t - 1][j]);
        r.push_back(row);
    }
    return r;
}
Mat shrunkCov(const Mat& R) {
    int T = (int)R.size(), n = (int)R[0].size();
    Vec mean(n, 0.0);
    for (auto& r : R) for (int j = 0; j < n; j++) mean[j] += r[j] / T;
    Mat S(n, Vec(n, 0.0));
    for (auto& r : R)
        for (int i = 0; i < n; i++)
            for (int j = 0; j < n; j++)
                S[i][j] += (r[i] - mean[i]) * (r[j] - mean[j]) / (T - 1) * TRADING_DAYS;
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            S[i][j] = (i == j) ? S[i][j] : (1 - SHRINK) * S[i][j];
    return S;  // diagonal kept, off-diagonals shrunk by SHRINK (same as (1-s)S + s*diag)
}
void expectedReturns(const Mat& R, const vector<string>& names, Vec& mu, Vec& beta) {
    int T = (int)R.size(), n = (int)names.size();
    Vec bench(T);
    int bi = -1;
    for (int j = 0; j < n; j++) if (names[j] == BENCHMARK) bi = j;
    for (int t = 0; t < T; t++) {
        if (bi >= 0) bench[t] = R[t][bi];
        else { double s = 0; for (int j = 0; j < n; j++) s += R[t][j]; bench[t] = s / n; }
    }
    double bm = 0; for (double b : bench) bm += b / T;
    double bv = 0; for (double b : bench) bv += (b - bm) * (b - bm) / (T - 1);
    mu.assign(n, 0); beta.assign(n, 0);
    for (int j = 0; j < n; j++) {
        double m = 0; for (int t = 0; t < T; t++) m += R[t][j] / T;
        double c = 0; for (int t = 0; t < T; t++) c += (R[t][j] - m) * (bench[t] - bm) / (T - 1);
        beta[j] = c / bv;
        double hist = max(-0.5, min(0.8, m * TRADING_DAYS));
        double prior = RISK_FREE + beta[j] * MARKET_PREMIUM;
        mu[j] = HIST_WEIGHT * hist + (1 - HIST_WEIGHT) * prior;
    }
}
double portSharpe(const Vec& w, const Vec& mu, const Mat& S, double rf, double* ret = nullptr, double* vol = nullptr) {
    double r = dot(w, mu), v = sqrt(max(1e-18, dot(w, matvec(S, w))));
    if (ret) *ret = r;
    if (vol) *vol = v;
    return (r - rf) / v;
}
// Euclidean projection onto {0 <= w <= cap, sum w = 1} via bisection on the shift.
Vec projectCappedSimplex(const Vec& v, double cap) {
    double lo = *min_element(v.begin(), v.end()) - cap, hi = *max_element(v.begin(), v.end());
    Vec w(v.size());
    for (int it = 0; it < 100; it++) {
        double tau = 0.5 * (lo + hi), s = 0;
        for (size_t i = 0; i < v.size(); i++) s += min(cap, max(0.0, v[i] - tau));
        (s > 1 ? lo : hi) = tau;
    }
    double tau = 0.5 * (lo + hi);
    for (size_t i = 0; i < v.size(); i++) w[i] = min(cap, max(0.0, v[i] - tau));
    return w;
}
// Long-only, position-capped optimization by projected gradient (multi-start).
Vec optimizeLongOnly(const Vec& mu, const Mat& S, double rf, double maxW, bool sharpe) {
    int n = (int)mu.size();
    double cap = max(maxW, 1.0 / n + 1e-6);
    auto f = [&](const Vec& w) {
        return sharpe ? -portSharpe(w, mu, S, rf) : dot(w, matvec(S, w));
    };
    auto grad = [&](const Vec& w) {
        Vec Sw = matvec(S, w), g(n);
        if (!sharpe) { for (int i = 0; i < n; i++) g[i] = 2 * Sw[i]; return g; }
        double r = dot(w, mu), s2 = max(1e-18, dot(w, Sw)), s = sqrt(s2);
        for (int i = 0; i < n; i++) g[i] = -(mu[i] / s - (r - rf) * Sw[i] / (s2 * s));
        return g;
    };
    mt19937 gen(1); exponential_distribution<double> E(1.0);
    Vec best; double bestF = 1e300;
    for (int start = 0; start < 5; start++) {
        Vec w(n, 1.0 / n);
        if (start > 0) { double s = 0; for (auto& x : w) { x = E(gen); s += x; } for (auto& x : w) x /= s; }
        w = projectCappedSimplex(w, cap);
        double step = 1.0, fw = f(w);
        for (int it = 0; it < 3000; it++) {
            Vec g = grad(w), v(n);
            bool moved = false;
            for (int ls = 0; ls < 40; ls++) {
                for (int i = 0; i < n; i++) v[i] = w[i] - step * g[i];
                Vec nw = projectCappedSimplex(v, cap);
                double fn = f(nw);
                if (fn < fw - 1e-14) { w = nw; fw = fn; step *= 1.5; moved = true; break; }
                step *= 0.5;
            }
            if (!moved) break;
        }
        if (fw < bestF) { bestF = fw; best = w; }
    }
    return best;
}

struct Result {
    Vec mu, beta, vol, w, wMinVar, wTan;
    Mat cov, corr;
    double ret, volP, sharpe, pc1, top3, eff, cond;
    Vec pc1Load;
};
Result analyze(const Mat& px, const vector<string>& names, double maxW) {
    Result r;
    Mat R = logReturns(px);
    int n = (int)names.size();
    r.cov = shrunkCov(R);
    expectedReturns(R, names, r.mu, r.beta);
    r.vol.resize(n);
    for (int i = 0; i < n; i++) r.vol[i] = sqrt(r.cov[i][i]);
    r.corr.assign(n, Vec(n));
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++) r.corr[i][j] = r.cov[i][j] / (r.vol[i] * r.vol[j]);
    Vec ev; Mat V;
    jacobiEigen(r.corr, ev, V);
    double tot = 0; for (double e : ev) tot += e;
    double H = 0;
    for (double e : ev) if (e > 1e-12) H -= (e / tot) * log(e / tot);
    r.eff = exp(H); r.pc1 = ev[0] / tot;
    r.top3 = (ev[0] + ev[1] + ev[2]) / tot;
    r.cond = ev.front() / max(1e-300, ev.back());
    double sgn = 0; for (int i = 0; i < n; i++) sgn += V[i][0];
    r.pc1Load.resize(n);
    for (int i = 0; i < n; i++) r.pc1Load[i] = V[i][0] * (sgn < 0 ? -1 : 1);
    // closed-form (shorts allowed): Sigma^-1 1  and  Sigma^-1 (mu - rf)
    Vec ones(n, 1.0), ex(n);
    for (int i = 0; i < n; i++) ex[i] = r.mu[i] - RISK_FREE;
    Vec x = solve(r.cov, ones), y = solve(r.cov, ex);
    double sx = 0, sy = 0; for (int i = 0; i < n; i++) { sx += x[i]; sy += y[i]; }
    r.wMinVar = x; r.wTan = y;
    for (int i = 0; i < n; i++) { r.wMinVar[i] /= sx; r.wTan[i] /= sy; }
    r.w = optimizeLongOnly(r.mu, r.cov, RISK_FREE, maxW, true);
    r.sharpe = portSharpe(r.w, r.mu, r.cov, RISK_FREE, &r.ret, &r.volP);
    return r;
}

